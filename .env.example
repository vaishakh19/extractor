# Exchange credentials are only needed for LIVE mode. Never enable withdrawal permission.
EXCHANGE=binance
API_KEY=
API_SECRET=
API_PASSWORD=

# PAPER is always the safe default. LIVE still requires interactive CLI confirmation.
TRADING_MODE=paper
DEFAULT_SYMBOL=BTC/USDT
TIMEFRAME=5m
STRATEGY=combined
POLL_INTERVAL_SECONDS=15
CANDLE_LIMIT=250

INITIAL_PAPER_BALANCE=1000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5
PAPER_PARTIAL_FILL_RATIO=1.0

RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
MAX_POSITION_PERCENT=0.25
STOP_LOSS_PERCENT=1.0
TAKE_PROFIT_PERCENT=2.0

EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
VOLUME_PERIOD=20
VOLUME_MULTIPLIER=1.0

DATABASE_URL=sqlite:///data/bot.db
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=5
